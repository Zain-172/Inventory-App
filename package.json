{
  "name": "desktop-app",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && nodemon server.js",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron electron/main.js",
    "build:backend": "node scripts/build-backend.js",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "release": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^39.8.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "nodemon": "^3.1.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "electron/**"
    ],
    "appId": "com.desktop.app",
    "productName": "Inventory-Manager",
    "publish": [
      {
        "provider": "github",
        "owner": "Zain-172",
        "repo": "Inventory-App"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-backend/",
        "to": "backend/"
      },
      {
        "from": "backend/node_modules/better-sqlite3/",
        "to": "backend/"
      },
      {
        "from": "backend/Database/",
        "to": "backend/Database/"
      },
      {
        "from": "dist-frontend/",
        "to": "dist-frontend/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}
