><sort/><column_widths><column index="1" value="29"/><column index="2" value="46"/><column index="3" value="39"/><column index="4" value="66"/><column index="5" value="85"/><column index="6" value="132"/><column index="7" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="raw_material" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="49"/><column index="3" value="71"/><column index="4" value="55"/><column index="5" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sale_items" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="51"/><column index="2" value="50"/><column index="3" value="55"/><column index="4" value="89"/><column index="5" value="55"/><column index="6" value="36"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="140"/><column index="2" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TRIGGER deduct_raw_material_quantity
AFTER INSERT ON raw_material
FOR EACH ROW
BEGIN
    UPDATE products
    SET quantity = quantity - NEW.quantity
    WHERE id = NEW.raw_id;
END;

CREATE TRIGGER deduct_raw_material_update
AFTER INSERT ON raw_material
FOR EACH ROW
BEGIN
    UPDATE products
    SET quantity = quantity - NEW.quantity
    WHERE id = NEW.raw_id;
END;</sql><sql name="Edit Trigger deduct_raw_material_on_product_insert*">DROP TRIGGER IF EXISTS deduct_raw_material_on_product_insert;

CREATE TRIGGER deduct_raw_material_on_product_insert
AFTER UPDATE OF stock ON products
FOR EACH ROW
WHEN NEW.stock &gt; OLD.stock AND EXISTS (
    SELECT 1 FROM raw_material WHERE product_id = NEW.id
)
BEGIN
    UPDATE products
    SET stock = stock - (
        SELECT rm.quantity * (NEW.stock - OLD.stock)
        FROM raw_material rm
        WHERE rm.raw_id = products.id
        AND rm.product_id = NEW.id
    )
    WHERE id IN (
        SELECT raw_id
        FROM raw_material
        WHERE product_id = NEW.id
    );
END;</sql><sql name="Edit Trigger prevent_negative_raw_stock*">DROP TRIGGER IF EXISTS prevent_negative_raw_stock;

CREATE TRIGGER prevent_negative_raw_stock
BEFORE UPDATE OF stock ON products
FOR EACH ROW
WHEN EXISTS (
    SELECT 1
    FROM raw_material rm
    JOIN products p ON p.id = rm.raw_id
    WHERE rm.product_id = NEW.id
      AND p.stock &lt; rm.quantity * (NEW.stock - OLD.stock)
)
BEGIN
    SELECT RAISE(ABORT, 'Insufficient raw material stock');
END;</sql><current_tab id="2"/></tab_sql></sqlb_project>
